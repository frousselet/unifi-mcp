# =============================================================================
# UniFi MCP — environment configuration
# =============================================================================
# One cloud API key created at https://unifi.ui.com (or https://<tenant>.ui.com)
# can drive ALL four APIs. Give it the "Site Manager" + "UniFi Applications"
# (Network, Protect) scopes and, if available, the "mobility" scope.
# -----------------------------------------------------------------------------

# Required: your UniFi cloud API key (X-API-Key).
UNIFI_API_KEY=your-api-key-here

# Optional: HTTP timeout in seconds (default: 30).
# UNIFI_API_TIMEOUT=30


# --- Reaching a console (Network + Protect) --------------------------------
# Two mutually exclusive ways to reach a UniFi console:
#
# A) CLOUD CONNECTOR (recommended, works with the unifi.ui.com key, no LAN):
#    Set the console (host) ID. Requests are proxied through api.ui.com to the
#    console. Find the ID with the Site Manager `list_hosts` tool (the "id"
#    field, e.g. 900A6F...:123456789).
# UNIFI_CONSOLE_ID=900A6F00301100000000074A6BA90000000007A3387E0000000063EC9853:123456789
#
#    Per-application overrides (optional; fall back to UNIFI_CONSOLE_ID):
# UNIFI_NETWORK_CONSOLE_ID=
# UNIFI_PROTECT_CONSOLE_ID=
#
# B) LOCAL CONSOLE (direct LAN connection to the console IP/hostname):
# UNIFI_NETWORK_HOST=192.168.1.1
# UNIFI_PROTECT_HOST=192.168.1.1
#    Local consoles use self-signed certs; verification is off by default.
# UNIFI_NETWORK_VERIFY_SSL=false
# UNIFI_PROTECT_VERIFY_SSL=false
#
# If neither is set for an application, its tools are simply disabled.


# --- Per-API key overrides (optional) --------------------------------------
# All of these fall back to UNIFI_API_KEY.
# UNIFI_MOBILITY_API_KEY=
# UNIFI_NETWORK_API_KEY=
# UNIFI_PROTECT_API_KEY=


# --- Server exposure (docker-compose) --------------------------------------
# Host port the streamable-HTTP MCP endpoint is published on (default 8000).
# The MCP endpoint is then reachable at http://<host>:<MCP_PORT>/mcp
# MCP_PORT=8000


# =============================================================================
# Multi-user web GUI  (the DEFAULT `docker compose up` service)
# =============================================================================
# EVERYTHING BELOW IS OPTIONAL — `docker compose up` works with none of it:
#   - the encryption key is auto-generated and persisted to the data volume,
#   - the public URL is auto-detected from each request.
# Users self-register with passkeys and create/revoke their own MCP connections
# through the web UI. The single-tenant vars above are NOT used in this mode.

# Recommended in production: the public https origin. When set, it overrides
# request auto-detection so OAuth 401 hints match exactly. Passkeys require
# HTTPS (except on localhost).
# UNIFI_PUBLIC_URL=https://unifi.example.com

# Override the auto-generated Fernet key (encrypts stored UniFi keys/secrets).
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# UNIFI_SECRET_KEY=

# Where the encrypted store + auto key file live (container path; on a volume).
# UNIFI_TENANT_STORE=/data/unifi_tenants.json

# Name shown in the passkey prompt.
# UNIFI_RP_NAME=UniFi MCP

# Optional: require an invite code to self-register.
# UNIFI_ONBOARD_CODE=

# Optional: override the OAuth redirect allow-list (comma-separated). Defaults
# to Claude's web connector callbacks.
# UNIFI_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
